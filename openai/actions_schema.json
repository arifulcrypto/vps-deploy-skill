{
  "openapi": "3.1.0",
  "info": {
    "title": "VPS Deployment API",
    "version": "2.0.0",
    "description": "Wraps scripts/vps_deployer.py. Host this wrapper yourself behind authentication; it handles server credentials."
  },
  "servers": [
    {
      "url": "https://api.yourdomain.com/v1"
    }
  ],
  "paths": {
    "/deploy": {
      "post": {
        "operationId": "deployVPS",
        "summary": "Plan (dry_run) or run a deployment",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DeployRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Deployment or plan result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DeployResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation or deployment error (nothing was written locally)",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "DeployRequest": {
        "type": "object",
        "required": [
          "ip"
        ],
        "properties": {
          "dry_run": {
            "type": "boolean",
            "default": false
          },
          "ip": {
            "type": "string",
            "description": "Server IPv4 address"
          },
          "ssh_port": {
            "type": "integer",
            "default": 22
          },
          "ssh_user": {
            "type": "string",
            "default": "root"
          },
          "ssh_pass": {
            "type": "string",
            "description": "SSH password (or ssh_key)"
          },
          "ssh_key": {
            "type": "string",
            "description": "Path to an SSH private key on the wrapper host"
          },
          "profile": {
            "type": "string",
            "enum": [
              "unified",
              "legacy",
              "reality-self",
              "vision-tls"
            ],
            "default": "unified"
          },
          "domain": {
            "type": "string",
            "description": "unified: Cloudflare-proxied WS domain; reality-self: DNS-only domain (required)"
          },
          "ipv6": {
            "type": "string"
          },
          "ipv6_domain": {
            "type": "string",
            "description": "unified only: extra CDN node"
          },
          "panel_domain": {
            "type": "string",
            "description": "Expose the panel over HTTPS on this DNS-only domain"
          },
          "enable_hy2": {
            "type": "boolean"
          },
          "reality_sni": {
            "type": "string",
            "description": "unified REALITY target",
            "default": "addons.mozilla.org"
          },
          "client_isp": {
            "type": "string",
            "enum": [
              "unicom",
              "mobile",
              "telecom",
              "overseas"
            ],
            "default": "unicom"
          },
          "client_ip": {
            "type": "string"
          },
          "client_location": {
            "type": "string"
          },
          "node_prefix": {
            "type": "string",
            "default": "srv"
          },
          "site_title": {
            "type": "string"
          },
          "xui_version": {
            "type": "string",
            "example": "v3.11.0"
          },
          "adopt_existing_panel": {
            "type": "boolean",
            "default": false
          },
          "stop_conflicting_services": {
            "type": "boolean",
            "default": false
          },
          "rotate_secrets": {
            "type": "boolean",
            "default": false
          },
          "online_sub": {
            "type": "boolean",
            "default": false
          },
          "lang": {
            "type": "string",
            "enum": [
              "en",
              "zh"
            ],
            "default": "en"
          },
          "panel_port": {
            "type": "integer"
          },
          "reality_port": {
            "type": "integer",
            "description": "Default: 443 when no domain needs it and it is free"
          },
          "hy2_port": {
            "type": "integer"
          },
          "https_port": {
            "type": "integer",
            "default": 443
          },
          "web_backend_port": {
            "type": "integer",
            "default": 8443
          },
          "sub_port": {
            "type": "integer",
            "default": 2096
          },
          "vmess_port": {
            "type": "integer"
          },
          "trojan_port": {
            "type": "integer"
          },
          "output_dir": {
            "type": "string"
          },
          "acme_email": {
            "type": "string"
          },
          "ssh_known_hosts": {
            "type": "string",
            "description": "known_hosts file with the verified server key"
          },
          "panel_private": {
            "type": "boolean",
            "default": false
          },
          "reinstall_xui": {
            "type": "boolean",
            "default": false
          },
          "fail_closed": {
            "type": "boolean",
            "default": false,
            "description": "Fail the deployment when the panel login probe fails"
          },
          "enable_sub": {
            "type": "boolean",
            "default": true,
            "description": "Publish the 3X-UI built-in subscription"
          },
          "cdn_domain": {
            "type": "string",
            "description": "reality-self only: Cloudflare-proxied hostname on the shared HTTPS port"
          },
          "cert_mode": {
            "type": "string",
            "enum": [
              "http-01",
              "dns-01"
            ],
            "default": "http-01"
          },
          "cf_token": {
            "type": "string",
            "description": "Cloudflare API token for dns-01"
          },
          "extra_protocols": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "vmess",
                "trojan"
              ]
            }
          },
          "relays": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "name",
                "server",
                "port"
              ],
              "properties": {
                "name": {
                  "type": "string"
                },
                "server": {
                  "type": "string"
                },
                "port": {
                  "type": "integer"
                }
              }
            }
          },
          "residential": {
            "type": "array",
            "description": "Client-side SOCKS5 nodes; no server-side exit routing",
            "items": {
              "type": "object",
              "required": [
                "name",
                "server",
                "port",
                "username",
                "password"
              ],
              "properties": {
                "name": {
                  "type": "string"
                },
                "server": {
                  "type": "string"
                },
                "port": {
                  "type": "integer"
                },
                "username": {
                  "type": "string"
                },
                "password": {
                  "type": "string"
                }
              }
            }
          },
          "hy2_up": {
            "type": "integer",
            "description": "Client Mbps; set with hy2_down to use Brutal"
          },
          "hy2_down": {
            "type": "integer",
            "description": "Client Mbps; set with hy2_up to use Brutal"
          },
          "cdn_transport": {
            "type": "string",
            "enum": [
              "ws",
              "xhttp",
              "both"
            ]
          },
          "manage_dns": {
            "type": "boolean",
            "default": false,
            "description": "Create or update Cloudflare records; needs cf_token"
          },
          "exit_port": {
            "type": "integer"
          },
          "hy2_masquerade": {
            "type": "boolean",
            "default": false
          },
          "exit_proxy": {
            "type": "object",
            "required": [
              "server",
              "port"
            ],
            "properties": {
              "server": {
                "type": "string"
              },
              "port": {
                "type": "integer"
              },
              "username": {
                "type": "string"
              },
              "password": {
                "type": "string"
              },
              "protocol": {
                "type": "string",
                "enum": [
                  "socks",
                  "http"
                ],
                "default": "socks"
              }
            }
          }
        }
      },
      "DeployResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "success",
              "dry_run_success"
            ]
          },
          "profile": {
            "type": "string"
          },
          "panel": {
            "type": "object",
            "properties": {
              "url": {
                "type": "string"
              },
              "user": {
                "type": "string"
              },
              "pass": {
                "type": "string"
              },
              "public": {
                "type": "boolean"
              },
              "tunnel": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          },
          "ports": {
            "type": "object"
          },
          "nodes": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "route": {
                  "type": "string",
                  "enum": [
                    "direct",
                    "cdn"
                  ]
                },
                "uri": {
                  "type": "string"
                }
              }
            }
          },
          "online_subscriptions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "files": {
            "type": "object"
          },
          "notes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
